        {
            "name": "place_obstacles",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/place_obstacles.py",
            "console": "integratedTerminal",
            // 沿「关键 link 扫掠走廊」自动放障碍 + 三条件验证，每个成功场景存一个 npz 到 --out_dir。
            // M（每场景障碍数）、N（重试次数）、key_links、各阈值在 configs/default.yaml 的 obstacle_placement 段。
            "args": [
                // 焊缝 pkl（默认就是这个 seam_22；换焊缝改这里）：
                "--seam", "/media/a/新加卷/hanfeng/segment_sub_output/BEAM_1aEEYa00Ed5Z4sE34qDJKu_part/seam_22.pkl",
                // 末端目标沿 bisector 后退的 offset（厘米，默认 10）：
                "--offset_cm", "10",
                // 场景 npz 输出目录（默认 /tmp/placed_obstacles）：
                "--out_dir", "/tmp/placed_obstacles",
                // 随机种子（控尺寸/角度/位置采样 + 类型抽取，可复现；默认 0）：
                "--seed", "0",
                // ---- 以下为可选覆盖，注释掉则用 default.yaml 的值 ----
                // 覆盖 key_links（逗号分隔；缺省=配置里 6 个关键 link）。例：只跑 Link3、Link5：
                "--links", "xiaoyu_accessory_link",
                // 覆盖障碍类型集合（逗号分隔；缺省=obstacles 的全部 15 种，未用优先随机抽）。例：只用这 3 种：
                "--types", "plate",
                // "--types", "l_bracket",
                // "--types", "u_channel",
                // "--types", "open_box",
                // "--types", "pipe",
                // "--types", "parallel_pipes",
                // "--types", "crossed_pipes",
                // "--types", "box_beam",
                // "--types", "rect_frame",
                // "--types", "gantry",
                // "--types", "braced_frame",
                // "--types", "tripod",
                // "--types", "steps",
                // "--types", "box_with_pipe",
                // "--types", "frame_with_brace",
                // 覆盖 N（单个 link 放置失败后的最大重试次数；缺省=配置 max_attempts）。调试时设小加快：
                "--max_attempts", "20",
            ]
        },
        {
