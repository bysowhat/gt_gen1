        {
            "name": "compute_goal_poses",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/compute_goal_poses.py",
            "console": "integratedTerminal",
            // 移植 stomp_planner 观测位姿优化器（per-seam .pkl 输入）+ Isaac Sim 可视化 goal pose 序列。
            // --usd 默认取 pkl 同目录的 *_part.usd；num_envs = num_batches*(num_randoms_new+num_randoms_old)，优化器按此 reshape。
            "args": [
                // 输入：单条焊缝 pkl（gt_overall 格式：robot_pose/piece_pose/horizontal/seam_*）
                "--seam-pkl", "/media/a/新加卷/hanfeng/segment_sub_output/BEAM_1aEEYa00Ed5Z4sE34qDJKu_part/seam_1.pkl",
                // 工件 USD（缺省自动取 pkl 同目录 *_part.usd）：
                "--usd", "/media/a/新加卷/hanfeng/segment_sub_output/BEAM_1aEEYa00Ed5Z4sE34qDJKu_part/BEAM_1aEEYa00Ed5Z4sE34qDJKu_part.usd",
                // 进化策略并行规模（缺省 num_batches=8, num_randoms_new=100 -> num_envs=800）：
                "--num-batches", "8",
                "--num-randoms-new", "50", // 100
                // 把 goal poses 存盘（之后用 viz_goal_poses_isaacsim.py 可视化）：
                "--save", "/tmp/goal_poses/goal_poses.pkl",
                // 无显示器（headless）：
                "--headless",
            ]
        },
